# Optional server-side credentials only.
# Never expose secrets with NEXT_PUBLIC_.
# Open-Meteo, RainViewer, NASA GIBS and OpenStreetMap need NO keys.

# MOSDAC / ISRO credentials if your authorized dataset requires them:
# Without these the MOSDAC layer shows AUTH (adapter path only, never faked).
MOSDAC_USERNAME=
MOSDAC_PASSWORD=
MOSDAC_DATASET_ID=

# Optional backend URL if a separate FastAPI service is added:
# The Next.js app runs fully without it (uses /api/* routes).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
